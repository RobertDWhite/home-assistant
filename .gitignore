# Example .gitignore file for your config dir.
# A * ensures that everything will be ignored.
*

# You can whitelist files/folders with !, these will not be ignored.
!*.yaml
!.gitignore
!*.md
!/automations
!automations
!/scripts
!scripts
!/sensor
!sensor
!/switch
!switch
!rest
!/rest

# Ignore folders.
.storage
.cloud
.google.token

# Ensure these YAML files are ignored, otherwise your secret data/credentials will leak.
ip_bans.yaml
secrets.yaml
known_devices.yaml
._configuration.yaml
._notify.yaml
._secrets.yaml
google_calendars.yaml
google_calendars.yaml
automations.yaml

# template: directory (template/) is included by configuration.yaml too
!/template
!template


# dashboards/: generated copies live on the HA box (/config/dashboards), never in this public repo
dashboards/

# ha-lock: versioned inventory of core / HACS / add-on versions (see README)
!ha-lock.json
!ha-lock.sh

# custom_templates/: shared Jinja macros (imported by template entities)
!/custom_templates
!custom_templates
!custom_templates/*.jinja

# themes/: frontend themes (merged by frontend: themes: !include_dir_merge_named themes)
!/themes
!themes
# www/themes: theme background images
!/www
!www
www/*
!www/themes
!www/themes/*.jpg
